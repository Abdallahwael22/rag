APP_NAME="mini-Rag"
APP_VERSION="0.1"
OPENAI_API_KEY=""
File_ALLOWED_TYPES=["text/plain","application/pdf"]
FILE_MAX_SIZE=10
# WE USED THE CHUNKS TO SPLIT THE FILE INTO SMALLER PARTS FOR BETTER PROCESSING AND TO AVOID MEMORY ISSUES. THE CHUNK SIZE CAN BE ADJUSTED BASED ON THE SPECIFIC REQUIREMENTS OF YOUR APPLICATION AND THE NATURE OF THE FILES YOU ARE HANDLING.
FILE_DEFAULT_CHUNK_SIZE=512000  #in bytes, equivalent to 500KB, which is a common chunk size for text processing tasks.